{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handoff-guard.invalid/schemas/execution-contract.v1.json",
  "title": "Handoff Guard execution contract v1",
  "type": "object",
  "required": ["contract_version", "handoff_id", "source_context", "objective", "current_state", "checkpoint", "locked_decisions", "mutable_implementation_choices", "constraints", "do_not", "context_manifest", "execution_surface", "model", "reasoning_effort", "sandbox", "approval_requirements", "preflight", "acceptance_criteria", "result_schema"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "source_context": {"type": "object"}, "objective": {"type": "object"}, "current_state": {"type": "object"}, "checkpoint": {"type": "object"},
    "locked_decisions": {"type": "array"}, "mutable_implementation_choices": {"type": "array"}, "constraints": {"type": "array"}, "do_not": {"type": "array"},
    "context_manifest": {"type": "object"}, "execution_surface": {"enum": ["work", "codex", "unknown"]}, "model": {"type": "object"}, "reasoning_effort": {"type": "string"},
    "sandbox": {"type": "object"}, "approval_requirements": {"type": "object"}, "preflight": {"type": "object"}, "acceptance_criteria": {"type": "array", "minItems": 1}, "result_schema": {"type": "object"},
    "retry_policy": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
